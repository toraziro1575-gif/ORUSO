rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function friendshipId(a, b) {
      return a < b ? a + "_" + b : b + "_" + a;
    }

    function areFriends(uid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/friendships/$(friendshipId(request.auth.uid, uid)));
    }

    function canReadRecords(uid) {
      return isOwner(uid) ||
        (
          get(/databases/$(database)/documents/users/$(uid)).data.visibility == "friends" &&
          areFriends(uid)
        );
    }

    match /usernames/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userId == userId;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if false;

      match /{recordType}/{recordId} {
        allow read: if recordType in ['workouts', 'meals', 'weights']
          && canReadRecords(uid);
        allow create, update, delete: if recordType in ['workouts', 'meals', 'weights']
          && isOwner(uid);
      }
    }

    match /friendRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.receiverUid != request.auth.uid
        && request.resource.data.status == "pending";

      allow read: if signedIn()
        && (
          resource.data.senderUid == request.auth.uid ||
          resource.data.receiverUid == request.auth.uid
        );

      allow update: if signedIn()
        && resource.data.receiverUid == request.auth.uid
        && resource.data.status == "pending"
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.receiverUid == resource.data.receiverUid
        && request.resource.data.status in ["accepted", "rejected"];

      allow delete: if signedIn()
        && (
          resource.data.senderUid == request.auth.uid ||
          resource.data.receiverUid == request.auth.uid
        );
    }

    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;

      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
